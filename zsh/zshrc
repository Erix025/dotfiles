# Allow per-host overrides without editing repo files
export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
export ZSH_DOTDIR="$DOTFILES_DIR/zsh"

# Load modules in order
source "$ZSH_DOTDIR/00-options.zsh"
source "$ZSH_DOTDIR/10-path.zsh"
source "$ZSH_DOTDIR/15-secrets.zsh"
source "$ZSH_DOTDIR/20-antigen.zsh"
source "$ZSH_DOTDIR/30-plugins.zsh"
source "$ZSH_DOTDIR/40-highlight.zsh"
source "$ZSH_DOTDIR/50-completion.zsh"
source "$ZSH_DOTDIR/60-keybinds.zsh"
source "$ZSH_DOTDIR/70-tools-ezsh.zsh"
source "$ZSH_DOTDIR/80-env-alias.zsh"
source "$ZSH_DOTDIR/90-theme.zsh"
source "$ZSH_DOTDIR/99-local.zsh"
